const path = require('path');

module.exports = {
  config: path.resolve('./src/db/config.js'), // Percorso al tuo file di configurazione di Sequelize
  modelsPath: path.resolve('./src/db/models'), // Percorso alla tua directory dei modelli
  migrationsPath: path.resolve('./src/db/migrations'), // Percorso alla tua directory delle migration

  // i seeders vengono generati nella cartella dist/db/seeders in .js
  // trasferirli in src/db/seeders e trasformarli in .ts
  // verranno poi ritrasformati e copiati nella cartella precedente dal compilatore
  // e sequelize poi li userà per il seeding
  seedersPath: path.resolve('./dist/db/seeders'), // Percorso alla tua directory dei seeder
};
