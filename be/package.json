{
  "name": "be-shop-sistemi-web",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "dev": "npm run schemas && npm run copyfiles && tsc -p tsconfig.build.json -w & nodemon dist/app.js",
    "dev:win": "npm run schemas && npm run copyfiles && start /b tsc -p tsconfig.build.json -w & nodemon --config nodemon.win.json dist/app.js",
    "schemas": "npm run schemas:openapi && npm run schemas:types",
    "schemas:openapi": "swagger-jsdoc -d ./_data/definition.yaml src/api/routes/*.ts \"./_data/!(definition).yaml\" -o src/api/schemas/openapi.json",
    "schemas:types": "openapi-typescript src/api/schemas/openapi.json -o src/api/schemas/index.d.ts",
    "copyfiles": "copyfiles -u 1 src/api/schemas/*.json dist",
    "start:server": "tsc -p tsconfig.build.json && node dist/app.js",
    "clean": "node _scripts/clean.js",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "author": "MV",
  "license": "ISC",
  "description": "on-line shop per progetto sistemi web",
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "openapi-typescript": "^7.6.1",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.1.0",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.4.9",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.0",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1"
  }
}
